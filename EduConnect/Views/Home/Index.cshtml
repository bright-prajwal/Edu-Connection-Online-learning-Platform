@{
    ViewData["Title"] = "Home Page";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />
    <style>
        #A {
            width: 100%;
            height: 500px;
            background-color: white;
        }
    </style>
    <title>Document</title>
</head>
<body>

    <div id="A">
        <div>
            <h1 class="text-4xl md:text-2xl font-bold mb-4">Featured Courses</h1>
        </div>
        <div id="Portfolio">
            <div class="card">
                <img alt="Group of people studying" class="rounded-full border-8 border-green-400" src="ADS.jpg" />
                <h3>
                    Advanced Computer Architecture
                </h3>
                <a href="#"></a>
            </div>
            <div class="card">
                <img src="8f.jpg" alt="" />
                <h3>Blockchain and its Applications</h3>
                <a href="#">Data Analyst</a>
            </div>

            <div class="card">
                <img src="8f.jpg" alt="" />
                <h3>Business Intelligence & Analytics</h3>
                <a href="">Data Analyst</a>
            </div>

            <div class="card">
                <img src="8f.jpg" alt="" />
                <h3>Deep Learning for Natural Language Processing</h3>
                <a href="#">Data Analyst</a>
            </div>

        </div>
    </div>
</body>
</html>

