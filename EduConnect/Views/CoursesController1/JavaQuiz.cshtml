<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: 'Roboto', sans-serif;
        }

        #quiz_page {
            margin-top: 10px;
            margin-left: 210px;
        }

        .hidden {
            display: none;
        }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen bg-gradient-to-r from-blue-10 to-purple-900">
    <div class="w-full max-w-4xl mx-auto p-4">
        <div id="quiz_page" class="flex flex-col md:flex-row bg-white rounded-lg shadow-lg overflow-hidden w-full max-w-4xl mx-auto p-4">
            <div class="w-full p-8">
                <h2 class="text-2xl font-bold text-purple-500 mb-3">Take the Quiz!</h2>
                <form id="quizForm">
                    <!-- Question 1 -->
                    <div class="mb-3">
                        <label class="form-label">1. Which of the following classes is part of the Java Collections Framework and implements the List interface?</label>
                        <div>
                            <div><label><input type="radio" name="question1" value="HashSet">HashSet </label></div>
                            <div><label><input type="radio" name="question1" value="LinkedList">LinkedList </label></div>
                            <div><label><input type="radio" name="question1" value="TreeMap">TreeMap</label></div>
                        </div>
                    </div>
                    <!-- Question 2 -->
                    <div class="mb-3">
                        <label class="form-label">
                            2. Which of the following interfaces is not part of the Java Collections Framework?
                           
                        </label>
                        <div>
                            <div><label><input type="radio" name="question2" value="Set"> Set</label></div>
                            <div><label><input type="radio" name="question2" value="Queue">Queue </label></div>
                            <div><label><input type="radio" name="question2" value="Stream">Stream</label></div>
                        </div>
                    </div>
                    <!-- Question 3 -->
                    <div class="mb-3">
                        <label class="form-label">Which of the Following is not a keyWord in Java?</label>
                        <div>
                            <div><label><input type="radio" name="question3" value="Improt">import</label></div>
                            <div><label><input type="radio" name="question3" value="Super"> Super</label></div>
                            <div><label><input type="radio" name="question3" value="George Orwell">Method</label></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Which of the Following concept that Java does not support ?</label>
                        <div>
                            <div><label><input type="radio" name="question4" value="Improt">Inheritance</label></div>
                            <div><label><input type="radio" name="question4" value="pointer">Pointer</label></div>
                            <div><label><input type="radio" name="question4" value="George Orwell">Encapsulation</label></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Which of the Following concept that Java does not support ?</label>
                        <div>
                            <div><label><input type="radio" name="question5" value="Improt">INT</label></div>
                            <div><label><input type="radio" name="question5" value="pointer">Boolen</label></div>
                            <div><label><input type="radio" name="question5" value="String">String</label></div>
                        </div>
                    </div>


                    <button type="button" id="submitBtn" class="w-full bg-purple-500 text-white py-2 rounded hover:bg-purple-600 mb-3">Submit Quiz</button>
                </form>
            </div>
        </div>
        <canvas id="resultsChart" class="hidden mt-4" width="200" height="200"></canvas>
    </div>
        <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="container" width="200" height="200">

    <script>
        document.getElementById('submitBtn').addEventListener('click', function () {
            // Correct Answers
            const correctAnswers = {
                        question1: "LinkedList",
                        question2: "Stream",
                        question3: "Super",
                        question4:"pointer",
                                question5:"String"
            };

            // Get User Answers
            const userAnswers = {
                question1: document.querySelector('[name="question1"]:checked')?.value || '',
                question2: document.querySelector('[name="question2"]:checked')?.value || '',
                question3: document.querySelector('[name="question3"]:checked')?.value || ''
            };

            // Calculate Score
            let score = 0;
            Object.keys(correctAnswers).forEach(question => {
                if (correctAnswers[question] === userAnswers[question]) {
                    score++;
                }
            });

            // Hide Quiz Section
            document.getElementById('quiz_page').classList.add('hidden');

            // Display the Pie Chart
            const ctx = document.getElementById('resultsChart').getContext('2d');
            document.getElementById('resultsChart').classList.remove('hidden'); // Unhide Canvas
            new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: ['Correct', 'Incorrect'],
                    datasets: [{
                        data: [score, Object.keys(correctAnswers).length - score],
                        backgroundColor: ['#4CAF50', '#F44336']
                    }]
                },
                options: {
                    responsive: true
                }
            });
        });
    </script>
    </div>
    </div>
</body>
</html>
