
@using EduConnect.Models;
@model CourseModel;
@{
    ViewData["Title"] = "";
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">


    <link rel="stylesheet" href="~/css/Signup1.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/css/Signup1.css" asp-append-version="true" /> *@
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        #login_page {
            margin-top: 10px;
            margin-left: 210px;
        }
        /* codeV{ */
        /*     width:105px; */

        /* } */
    </style>
</head>
<body class="flex items-center justify-center min-h-screen bg-gradient-to-r from-blue-10 to-purple-900 font-roboto">
    <div class="w-full max-w-4xl mx-auto p-4">
        <div id="login_page" class="flex flex-col md:flex-row bg-white rounded-lg shadow-lg overflow-hidden font-roboto w-full max-w-4xl mx-auto p-4 ">

            <div class="w-full p-8">
                <h2 class="text-2xl font-bold text-purple-500 mb-3">Add New Courses</h2>

                <div class="container">
                    @if(ViewBag.IsSuccess == true){
                        <hr />
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>Congratulation</strong> You should added new course Successfully<br />
                            <a asp-controller="CoursesController1" asp-action="course-details/{id}" asp-route-id="ViewBag.CourseId">Click here</a>view the details
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                        <hr />

                    }
                    <form method="post" enctype="multipart/form-data" asp-action="AddNewCourse" asp-controller="CoursesController1">
                        <hr />

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="CoursesName" class="form-label"></label>
                        <input asp-for="CoursesName" class="form-control" />
                        <span asp-validation-for="CoursesName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Instructor" class="form-label"></label>
                        <input asp-for="Instructor" class="form-control" />
                        <span asp-validation-for="Instructor" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Categories" class="form-label"></label>
                        <input asp-for="Categories" class="form-control" />
                        <span asp-validation-for="Categories" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control"></textarea> 
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                      <div class="mb-3">
                            <label asp-for="Module1" class="form-label"></label>
                            <input asp-for="Module1" class="form-control">
                            <span asp-validation-for="Module1" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Url2" class="form-label">Module One Video Url</label>
                            <input asp-for="Url2" class="form-control">
                            <span asp-validation-for="Url2" class="text-danger"></span>

                        </div>

                        <div class="mb-2">
                            <label asp-for="Module2" class="form-label"></label>
                            <input asp-for="Module2" class="form-control">
                            <span asp-validation-for="Module2" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Url3" class="form-label">Module Two Video Url</label>
                            <input asp-for="Url3" class="form-control">
                            <span asp-validation-for="Url3" class="text-danger"></span>

                        </div>

                        <div class="mb-2">
                            <label asp-for="Module3" class="form-label"></label>
                            <input asp-for="Module3" class="form-control">
                            <span asp-validation-for="Module3" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Url4" class="form-label">Module Three Video Url</label>
                            <input asp-for="Url4" class="form-control">
                            <span asp-validation-for="Url4" class="text-danger"></span>

                        </div>


                        <div class="mb-2">
                            <label asp-for="Module4" class="form-label"></label>
                            <input asp-for="Module4" class="form-control">
                            <span asp-validation-for="Module4" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Url5" class="form-label">Module For Video Url</label>
                            <input asp-for="Url5" class="form-control">
                            <span asp-validation-for="Url5" class="text-danger"></span>

                        </div>


                        <div class="mb-2">
                            <label asp-for="Module5" class="form-label"></label>
                            <input asp-for="Module5" class="form-control">
                            <span asp-validation-for="Module5" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Url6" class="form-label">Module Five Video Url</label>
                            <input asp-for="Url6" class="form-control">
                            <span asp-validation-for="Url6" class="text-danger"></span>

                        </div>

                        <div class="mb-2">
                            <label asp-for="Module6" class="form-label"></label>
                            <input asp-for="Module6" class="form-control">
                            <span asp-validation-for="Module6" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Url7" class="form-label">Module Six Url</label>
                            <input asp-for="Url7" class="form-control">
                            <span asp-validation-for="Url7" class="text-danger"></span>

                        </div>

                        <div class="mb-3"> 
                            <label asp-for="CoverPhoto" class="form-label">Cover Photo</label>
                            <input asp-for="CoverPhoto" type="file" class="form-control" />
                            <span asp-validation-for="CoverPhoto" class="text-danger"></span>
                        </div>


                        <div class="mb-3">
                            <label asp-for="UrlAttribute" class="form-label">Introduction Video Url</label>
                            <input asp-for="UrlAttribute" class="form-control">
                            <span asp-validation-for="UrlAttribute" class="text-danger"></span>
                            
                        </div>


                    <input type="submit" value="Add Courses" class="w-full bg-purple-500 text-white py-2 rounded hover:bg-purple-600 mb-3">
                    @* <p class="text-center mt-2"> *@
                    @*     Already have an account? <a asp-controller="Edu" asp-action="Login" class="text-decoration-none">Login</a> *@
                    @* </p> *@
                    <div class="text-center">
                        <a asp-controller="Edu" asp-action="Home" class="text-decoration-none mt-3">Back</a>
                    </div>





                </form>
                </div>
                
            </div>


        </div>
    </div>
</body>




