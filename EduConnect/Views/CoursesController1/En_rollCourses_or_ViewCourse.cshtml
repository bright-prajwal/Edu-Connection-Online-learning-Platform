                </ul>
            </div>
        </div>

        <!-- Modules Section -->
        <h4 class="text-center mt-5 mb-4">Course Modules</h4>
        <div class="row">
            <!-- Module 1 -->
            <div class="col-md-4 mb-4">
                <div class="card">
                    <img src="https://via.placeholder.com/400x250" class="card-img-top" alt="Module 1">
                    <div class="card-body">
                        <h4 class="card-title">Module 1</h4><br />
                        <p class="card-text">@Model.Module1</p>

                        <a href="@Model.Url2" class="btn btn-primary" target="_blank">Start Module</a>

                    </div>
                </div>
            </div>

            <!-- Module 2 -->
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Module 2</h4><br />
                        <p class="card-text">@Model.Module2</p>
                        <a href="@Model.Url3" class="btn btn-primary" target="_blank">Start Module</a>
                        @* <a href="https://youtu.be/pqDRgYqC_Lk?si=PX-r5O7LsETI9fNW" class="btn btn-primary" target="_blank">Start Module</a> *@

                    </div>
                </div>
            </div>

            <!-- Module 3 -->
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Module 3</h4><br />
                        <p class="card-text">@Model.Module3</p>
                        <a href="@Model.Url4" class="btn btn-primary" target="_blank">Start Module</a>

                    </div>
                </div>
            </div>

            <!-- Module 4 -->
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Module 4</h4><br />
                        <p class="card-text">@Model.Module4</p>
                        <a href="@Model.Url5" class="btn btn-primary" target="_blank">Start Module</a>
                    </div>
                </div>
            </div>

            <!-- Module 5 -->
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Module 5</h5><br />
                        <p class="card-text">@Model.Module5</p>
                        <a href="@Model.Url6" class="btn btn-primary" target="_blank">Start Module</a>
                    </div>
                </div>
            </div>

            <!-- Module 6 -->
            <div class="col-md-4 mb-4">
                <div class="card">
                    <img src="https://via.placeholder.com/400x250" class="card-img-top" alt="Module 6">
                    <div class="card-body">
                        <h5 class="card-title">Module 6</h5><br />
                        <p class="card-text">@Model.Module6</p>
                        <a href="@Model.Url7" class="btn btn-primary" target="_blank">Start Module</a>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="d-flex justify-content-center align-items-center">
            <div>
                <a class="btn btn-outline-primary w-100" href="@Url.Action("JavaQuiz", "CoursesController1")">
                    Take Quiz !
                </a>
            </div>
        </div>

            @* <li class="list-group-item"> *@
            @*     <span class="font-weight-bold">Category: </span>@Model.Categories *@
            @* </li> *@
            @* <li class="list-group-item"> *@
            @*     <span class="font-weight-bold">Category: </span>@Model.Categories *@

        
           </div>



