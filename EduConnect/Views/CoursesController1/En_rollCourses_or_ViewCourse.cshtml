</head>

<body>
    <div class="container mt-4">
        <h5 class="display-4 text-center mb-4">Course Details</h5>

        <div class="row">
            <div class="col-md-6">
                <div id="videoExample" class="mb-3">
                    <iframe width="100%" height="320" src="@Model.UrlAttribute" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen=""></iframe>
                </div>
            </div>

            <div class="col-md-6">
                <h3 class="text-primary">@Model.CoursesName</h3>
                <p class="text-muted"><span class="fw-bold">Instructor: </span>@Model.Instructor</p>

                <div class="mb-4">
                    <p class="lead">@Model.Description</p>
                </div>

                @* <div class="mb-3"> *@
                @*     <button class="btn btn-outline-primary w-100 " href="@Url.Action("JavaQuiz", "CoursesController1") > *@
                @*         Enroll Now *@
                @*     </button> *@
                @* </div> *@

                <div class="mb-3">
                <a class="btn btn-outline-primary w-100" href="@Url.Action("AdMycorse", "CoursesController1")">
                   Enroll Now
                    </a>
                </div>
                    <hr />

                <ul class="list-group">
                    <li class="list-group-item">
                        <span class="font-weight-bold">Category: </span>@Model.Categories
                    </li>
                    
                    @* <li class="list-group-item"> *@
                    @*     <span class="font-weight-bold">Category: </span>@Model.Categories *@
                    @* </li> *@
                    @* <li class="list-group-item"> *@
